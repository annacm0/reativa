# ========================
# BANCO DE DADOS
# ========================
# URL de conexão com o PostgreSQL
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL="postgresql://postgres:sua_senha@localhost:5432/reativa_dev"

# ========================
# JWT (JSON Web Token)
# ========================
# Chave secreta para assinar os tokens. Use uma string longa e aleatória.
# Gere uma com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="substitua-por-uma-chave-secreta-longa-e-aleatoria"

# Tempo de expiração do token (ex: 7d = 7 dias, 24h = 24 horas)
JWT_EXPIRES_IN="7d"

# ========================
# SERVIDOR
# ========================
PORT=3333
NODE_ENV="development"

# ========================
# FRONTEND
# ========================
# URL do frontend (para configurar o CORS no backend)
FRONTEND_URL="http://localhost:5173"

# ========================
# FRONTEND (Vite) — prefixo obrigatório: VITE_
# ========================
# URL base da API (usada pelo frontend para fazer requisições)
VITE_API_URL="http://localhost:3333"
