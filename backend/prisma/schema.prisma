// Prisma Schema — Reativa SaaS
//
// Arquitetura: core multissegmento, agnóstico de nicho de mercado.
// O sistema funciona para pet shops, salões, clínicas, oficinas, etc.
// Módulos específicos por segmento (ex: Pet) serão adicionados futuramente
// como extensões, sem alterar este core.

// ──────────────────────────────────────────────────────────────
// CONFIGURAÇÃO DO GERADOR
// ──────────────────────────────────────────────────────────────
generator client {
  provider = "prisma-client-js"
}

// ──────────────────────────────────────────────────────────────
// CONFIGURAÇÃO DO BANCO DE DADOS
// No Prisma 7, a URL de conexão vai em prisma.config.ts (não aqui)
// ──────────────────────────────────────────────────────────────
datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────────────────────
// ENUM: Papel do usuário dentro da empresa
// ──────────────────────────────────────────────────────────────
enum UserRole {
  ADMIN  // Acesso total: gerencia usuários, serviços e configurações
  MEMBER // Acesso operacional: cadastra clientes e registra atendimentos
}

// ──────────────────────────────────────────────────────────────
// MODEL: Company (Empresa / Tenant)
//
// Raiz do multi-tenancy. Todo dado pertence a uma empresa.
//
// Campo `segment`: classificação opcional do tipo de negócio.
// Serve como metadado — não altera a lógica do core no MVP.
// Ex: "PET_SHOP", "SALAO_BELEZA", "CLINICA", "BARBEARIA", "OFICINA"
// No futuro, habilitará módulos específicos por segmento.
// ──────────────────────────────────────────────────────────────
model Company {
  id      String  @id @default(uuid())
  name    String
  segment String? // Classificação do nicho — opcional, sem enforcement no MVP

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relacionamentos
  users        User[]
  clients      Client[]
  services     Service[]
  appointments Appointment[]

  @@map("companies")
}

// ──────────────────────────────────────────────────────────────
// MODEL: User (Usuário do sistema)
//
// Pertence a uma empresa. Email é globalmente único (usado no login).
// ──────────────────────────────────────────────────────────────
model User {
  id       String   @id @default(uuid())
  name     String
  email    String   @unique
  password String   // Sempre armazenado como hash bcrypt — nunca texto puro
  role     UserRole @default(MEMBER)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])       // Login por email — busca frequente
  @@index([companyId])   // Listar usuários da empresa

  @@map("users")
}

// ──────────────────────────────────────────────────────────────
// MODEL: Client (Cliente do estabelecimento)
//
// Entidade central do negócio. Pertence a uma empresa.
//
// Campo `notes`: observações livres sobre o cliente.
// Genérico por design — cada segmento usa como quiser:
//   Pet shop:  "Tem um labrador chamado Mel, com alergia a shampoo X"
//   Salão:     "Cabelo fino, prefere corte em camadas, alérgica a amônia"
//   Clínica:   "Plano de saúde XYZ, histórico de hipertensão"
// No futuro, módulos específicos terão suas próprias entidades estruturadas.
// ──────────────────────────────────────────────────────────────
model Client {
  id    String  @id @default(uuid())
  name  String
  phone String  // Validado e normalizado no backend (formato: apenas dígitos com DDI)
  email String? // Opcional
  notes String? // Observações livres — genérico, não interpretado pelo sistema

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relacionamentos
  appointments Appointment[]

  @@index([companyId])        // Listar clientes da empresa
  @@index([companyId, name])  // Busca por nome dentro da empresa

  @@map("clients")
}

// ──────────────────────────────────────────────────────────────
// MODEL: Service (Serviço oferecido pela empresa)
//
// Totalmente agnóstico de segmento:
//   Pet shop:  "Banho" (30 dias), "Tosa" (45 dias)
//   Salão:     "Corte" (30 dias), "Coloração" (60 dias)
//   Clínica:   "Consulta de rotina" (180 dias), "Fisioterapia" (7 dias)
//   Oficina:   "Troca de óleo" (90 dias), "Revisão" (365 dias)
//
// `returnIntervalDays` é a chave de todo o motor de recuperação.
// ──────────────────────────────────────────────────────────────
model Service {
  id                 String @id @default(uuid())
  name               String
  durationMinutes    Int?   // Duração aproximada em minutos — opcional (nem todo segmento usa)
  returnIntervalDays Int    // Intervalo esperado de retorno em dias

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]

  @@index([companyId])
  @@unique([companyId, name]) // Mesmo serviço não se repete na mesma empresa

  @@map("services")
}

// ──────────────────────────────────────────────────────────────
// MODEL: Appointment (Atendimento)
//
// Registra que um cliente recebeu um serviço em uma data.
// É a base de todo o motor de recuperação:
//
//   retornoPrevisto = date + service.returnIntervalDays
//
// Multi-tenancy: `companyId` é denormalizado aqui para permitir
// consultas diretas sem JOINs adicionais (performance).
//
// Não há referência a Pet — o Appointment é entre Client e Service.
// Um pet shop anota o pet em Client.notes ou aguarda o módulo Pet futuro.
// ──────────────────────────────────────────────────────────────
model Appointment {
  id    String   @id @default(uuid())
  date  DateTime // Data em que o atendimento ocorreu
  notes String?  // Observações do atendimento (opcional)

  // O atendimento pertence diretamente ao cliente
  clientId String
  client   Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Qual serviço foi realizado
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  // Restrict: impede excluir um serviço que tem histórico de atendimentos

  // Denormalizado para multi-tenancy direto (sem JOIN)
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])              // Atendimentos da empresa
  @@index([clientId])               // Histórico do cliente
  @@index([clientId, serviceId])    // Motor de recuperação: último atendimento por serviço
  @@index([companyId, date])        // Dashboard: atendimentos por período

  @@map("appointments")
}
